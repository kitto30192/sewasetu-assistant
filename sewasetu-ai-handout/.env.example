# Seva Setu — example environment. Copy to `.env` and fill in real values.
# NEVER commit `.env`; it is git-ignored on purpose.

# ---- App secrets (required) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-me-long-random-string

# The public URL people use to reach the portal (used in OAuth issuer + discovery).
PUBLIC_BASE_URL=http://your-domain-or-elb-url

# ---- Database (docker compose) ----
DB_NAME=sewasetu
DB_USER=sewasetu
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
# DB_PASSWORD is passed to containers; compose also expects POSTGRES_PASSWORD:
POSTGRES_PASSWORD=change-me

# ---- Scheme application window (YYYY-MM-DD HH:MM) ----
SCHEME_DEADLINE=2026-10-31 23:59

# ---- AI agent (only needed when you start the "ai" profile) ----
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MCP_TOKEN_SECRET=change-me
OFFICER_MCP_TOKEN=change-me
MCP_OFFICER_NAME=mcp-officer
